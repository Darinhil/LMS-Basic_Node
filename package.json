{
  "name": "lms-basic_node",
  "version": "1.0.0",
  "description": "Small library management system with Node.js, TypeScript, Express, and MySQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --loader ts-node/esm --experimental-specifier-resolution=node src/server.ts",
    "dev:watch": "node --watch --loader ts-node/esm --experimental-specifier-resolution=node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "echo \"No tests added yet\""
  },
